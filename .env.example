# frontier-adevar (Civa) Environment Variables
# Copy to .env.local and fill in values
#
# ⚠️  NEITHER variable is required — the app runs in demo/fallback mode without them.

# Encrypt/Ika API endpoint (defaults to https://api.encrypt.ika.network/v1)
# Documentation: https://docs.encrypt.network
NEXT_PUBLIC_ADEVAR_API_URL=https://api.encrypt.ika.network/v1

# API key for authenticated requests (optional — demo works without it)
# Note: Ika network does not currently require an API key (no developer portal yet)
ADEVAR_API_KEY=
